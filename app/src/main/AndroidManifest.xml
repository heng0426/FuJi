<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内升级：检查版本清单、下载 APK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".XiaoFuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaoFu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.XiaoFu">
            <!--
                锁定竖屏：全 App 按 360dp 竖屏单手操作设计（UI 规范 §1），
                横屏/折叠屏大屏适配未设计，P1 评估结论为锁定竖屏、v2 再评估。
                adjustResize：edge-to-edge 下由 Compose insets 处理键盘，避免系统默认 pan
                导致整页上移（异常编辑页真机反馈）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件：4×2 组合 + 2×2 喝水 + 2×2 喂食 -->
        <receiver
            android:name=".widget.CombinedWidgetProvider"
            android:exported="false"
            android:label="@string/widget_combined_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>

        <receiver
            android:name=".widget.WaterWidgetProvider"
            android:exported="false"
            android:label="@string/widget_water_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <receiver
            android:name=".widget.FeedWidgetProvider"
            android:exported="false"
            android:label="@string/widget_feed_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_feed_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- 应用内升级：PackageInstaller 会话结果回调（仅本应用内） -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- 把已校验的安装包以 content:// 交给系统安装器；
             部分 ROM 拦截 PackageInstaller 会话安装，这里提供可手动触发的等效路径 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
