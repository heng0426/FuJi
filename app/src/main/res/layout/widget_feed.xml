<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 喂食组件：头部在待机与确认态共用，主体在汇总与确认间切换 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pet_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ms_pets" />

            <TextView
                android:id="@+id/pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_default_pet"
                android:textColor="@color/w_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/food_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="今日主粮"
                android:textColor="@color/w_text2"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/idle_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sum2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/feed_servings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0 份"
                        android:textColor="@color/w_text"
                        android:textSize="37sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feed_grams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0 克"
                        android:textColor="@color/w_text2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sub_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="上次 3 份"
                        android:textColor="@color/w_text2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feed_cta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_food_light"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/feed_cta_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ms_restaurant" />

                    <TextView
                        android:id="@+id/feed_cta_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="记喂食"
                        android:textColor="@color/w_food"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/edit_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/edit_main"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/step_down"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/widget_outline_light"
                            android:clickable="true"
                            android:contentDescription="减少"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="−"
                            android:textColor="@color/w_text"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:baselineAligned="false"
                            android:gravity="center"
                            android:minWidth="60dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/edit_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="3"
                                android:textColor="@color/w_text"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/edit_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="份"
                                android:textColor="@color/w_text2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/step_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/widget_outline_light"
                            android:clickable="true"
                            android:contentDescription="增加"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="+"
                            android:textColor="@color/w_text"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/edit_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="15 克/份 · 共 45 克"
                        android:textColor="@color/w_text2"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/edit_cancel"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_outline_light"
                        android:clickable="true"
                        android:contentDescription="@string/widget_cancel"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/widget_cancel"
                        android:textColor="@color/w_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/edit_ok"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_primary_light"
                        android:clickable="true"
                        android:contentDescription="@string/widget_confirm_food"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/widget_confirm_food"
                        android:textColor="@color/w_on_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
